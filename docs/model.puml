@startuml
class Score {
}
class Repetition {
Score : score
Fraction : onset
Fraction : offset
Map[Fraction, int] : endings
}
class Part {
Score : score
int: idx
Instrument : instrument
}
class Staff {
Part : part
int : id
}
class Event {
Fraction : onset
}
class Clef {
int : staff_line
NoteName : note_name
int : octave
}
class KeySignature {
int : fifths
boolean : mode
}
class TimeSignature {
int : beats
int : beat_type
}
class OctaveShift {
Staff : staff
Fraction : onset
Fraction : offset
Octavation : octavation
}
class Measure {
Part: part
Fraction : onset
}
interface Site {
}
class Voice {
Part : part
int : id
}
class Tuplet {
Fraction : onset
int : normal_count, actual_count
NoteType : normal_type, actual_type
int : normal_dots, actual_dots
}
abstract class Element {
Site : site
NoteType : note_type
int : dots
}
abstract class ChordRest {
Event : event
BeamGroup : beam_group
bool: fermata
}
class Chord {
List[Expression] : expressions
Stem : stem
}
class Rest {
Fraction : nominal_duration
}
class GraceChord {
Chord : chord
int : index
NoteType : note_type
int : dots
List[Expression] : expressions
Stem : stem
BeamGroup : beam_group
}
class Note {
NoteName : note_name
int : octave
int : pitch
Accidental : accidental
}
class BeamGroup {
Voice : voice
}


Score "*" *-- Part
Score "onset" *-- Repetition
Part "id" *-- Staff
Part "id" *-- Voice
Staff "onset" *--Event
Staff "onset" *--Clef
Staff "onset" *--KeySignature
Staff "onset" *--TimeSignature
Staff "onset" *--OctaveShift
Part "onset" *-- Measure
Voice "onset" *-- BeamGroup
Site <|-- Voice
Site <|-- Tuplet
Event "voice" *-- ChordRest
BeamGroup "*" o-- ChordRest
BeamGroup "*" o-- GraceChord
Element <|-- Tuplet
Voice "onset" *-- Element
Tuplet "onset" *-- Element
Element <|-- ChordRest
ChordRest <|-- Chord
ChordRest <|-- Rest
Chord "*" *-- Note
Note "2" o-- Note
Chord "*" *-- GraceChord
GraceChord "*" *-- Note
@enduml